#!/usr/bin/env bash
# Re-attach DP-0 when the panel comes back from being powered off.
# DisplayPort drops the link when a monitor powers down; X then drops the mode
# and does not restore it on power-up, which is why the panel needs OSD poking.
: "${OUT:=DP-0}" "${MODE:=3840x2160}"
while true; do
  # The session's display number is not fixed (:0 or :1 depending on how GDM
  # started it), so take it from the session each pass rather than hard-coding.
  env_of() { systemctl --user show-environment 2>/dev/null | sed -n "s/^$1=//p"; }
  export DISPLAY="$(env_of DISPLAY)" XAUTHORITY="$(env_of XAUTHORITY)"
  [ -n "$DISPLAY" ] || { sleep 15; continue; }
  if xrandr --query 2>/dev/null | grep -q "^$OUT connected"; then
    # connected but no geometry => output is live again but unconfigured
    if ! xrandr --query 2>/dev/null | grep -E "^$OUT connected" | grep -qE '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+'; then
      logger -t display-keeper "$OUT returned without a mode - reapplying $MODE"
      xrandr --output "$OUT" --mode "$MODE" --scale 1x1 --pos 0x0 2>/dev/null
    fi
  fi
  sleep 15
done
