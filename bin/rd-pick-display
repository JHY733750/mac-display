#!/usr/bin/env python3
"""Switch a RustDesk session to a given remote display, and verify it took.

Why this is not just one xdotool click (all observed on RustDesk 1.4.6):

  * The toolbar is usually collapsed to a small handle at the top centre of the
    window, and has to be expanded before the display control exists.
  * The "1|2" control in the toolbar does NOT switch displays. Clicking it opens
    a dropdown; the per-display buttons inside that dropdown do the switching,
    and the dropdown closes itself after one is picked.
  * Nothing about the toolbar's position or size is fixed - it moves with the
    window, the handle can be dragged, and it scales with the desktop - so
    everything is measured from a screenshot each time.

Landmarks (dark theme), found by colour, not coordinates:

  * collapsed handle: a short near-black band at the very top; its chevron,
    the right-most icon, expands the toolbar
  * display control: the widest bright-blue run in the toolbar rows that sits
    on the toolbar's near-black background - the control's border. Its segments
    split that width evenly; the active display's segment is blue, the others
    are white.
  * dropdown buttons: the first boxes, 18-50 px wide, below the toolbar.

Success is read back from the control itself: after the switch, segment N is
the non-white one. RustDesk's log is not usable for this - it only prints "new
video handler for display #N" the first time a display is shown in a session,
so switching back to a display seen before leaves no trace there.

  rd-pick-display [--display N] [--window WID] [--tries N]

--display is 1-based, matching the numbers drawn in the UI.
"""
import argparse, os, re, subprocess, sys, time
from PIL import Image

LOG = os.path.expanduser("~/.local/share/logs/RustDesk/flutter_ffi/rustdesk_rCURRENT.log")
SEARCH_HALF_W = 450   # toolbar lives within this many px of the window's centre
BAR_ROWS = 70         # expanded toolbar: rows below the window top to search
HANDLE_ROWS = 70      # collapsed handle: rows below the window top (title bar or not)


def sh(*a):
    return subprocess.run(a, capture_output=True, text=True).stdout.strip()


def log_text():
    try:
        return open(LOG, "rb").read().decode("utf-8", "replace")
    except OSError:
        return ""


def display_count():
    m = re.findall(r"displays: \[(.*?)\], current_display", log_text(), re.S)
    return m[-1].count("DisplayInfo {") if m else 0


def grab(path="/tmp/rd-pick-display.png"):
    subprocess.run(["import", "-window", "root", path], check=True)
    return Image.open(path).convert("RGB")


def runs(px, y, x0, x1, pred, minw):
    out, start = [], None
    for x in range(x0, x1):
        if pred(px[x, y]):
            if start is None:
                start = x
        elif start is not None:
            if x - start >= minw:
                out.append((start, x))
            start = None
    if start is not None and x1 - start >= minw:
        out.append((start, x1))
    return out


def bright_blue(p):
    return p[2] >= 200 and p[0] <= 90 and p[2] - p[0] >= 150


def near_black(p):
    return max(p) <= 30


def find_control(img, x0, x1, top):
    """(left, right, y) of the display control's border, or None."""
    px = img.load()
    best = None
    for y in range(top, top + BAR_ROWS):
        for s, e in runs(px, y, x0, x1, bright_blue, 40):
            # The control sits on the toolbar's near-black background; a blue
            # run without that on both sides belongs to the Mac's screen.
            if not (any(near_black(px[x, y]) for x in range(max(x0, s - 12), s)) and
                    any(near_black(px[x, y]) for x in range(e, min(x1, e + 12)))):
                continue
            if best is None or e - s > best[1] - best[0]:
                best = (s, e, y)
    return best


def find_handle(img, x0, x1, top):
    """(left, right, y_mid) of the collapsed toolbar handle, or None."""
    px = img.load()
    rows = []
    for y in range(top, top + HANDLE_ROWS):
        r = [b for b in runs(px, y, x0, x1, near_black, 50) if b[1] - b[0] <= 260]
        if r:
            cx = (x0 + x1) // 2           # the handle is the band nearest the centre
            rows.append((y, min(r, key=lambda b: abs((b[0] + b[1]) // 2 - cx))))
    if not rows:
        return None
    (s, e) = rows[0][1]
    ys = [y for y, b in rows if abs(b[0] - s) <= 4 and abs(b[1] - e) <= 4]
    return s, e, (ys[0] + ys[-1]) // 2


def active_segment(img, ctl, n):
    """Index of the non-white segment of the display control, or None."""
    px = img.load()
    left, right, y = ctl
    seg_w = (right - left) / n
    row = y + 3                              # inside the border, above the digit
    white = []
    for i in range(n):
        xs = range(int(left + seg_w * (i + 0.2)), int(left + seg_w * (i + 0.8)))
        white.append(sum(min(px[x, row]) >= 200 for x in xs) > len(xs) // 2)
    dark = [i for i, w in enumerate(white) if not w]
    return dark[0] if len(dark) == 1 else None


def dropdown_buttons(img, ctl, n):
    """Centres of the first n per-display buttons in the open dropdown."""
    px = img.load()
    left, right, y = ctl
    xa, xb = left - 2, left + 60 * n + 10   # buttons start flush with the control
    found = []
    for row in range(y + 38, y + 120):
        boxes = [b for b in runs(px, row, xa, xb, lambda p: max(p) > 40, 18) if b[1] - b[0] <= 50]
        if len(boxes) >= n:
            found.append((row, boxes[:n]))
    if not found:
        return []
    row, boxes = found[len(found) // 2]      # a row through the middle of the buttons
    return [((s + e) // 2, row) for s, e in boxes]


def click(x, y, settle=0.6):
    subprocess.run(["xdotool", "mousemove", str(x), str(y)])
    time.sleep(settle)          # Flutter wants the hover event before the press
    subprocess.run(["xdotool", "click", "1"])
    time.sleep(settle)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--display", type=int, default=2, help="1-based display number")
    ap.add_argument("--window")
    ap.add_argument("--tries", type=int, default=3)
    a = ap.parse_args()
    want = a.display - 1                     # log and protocol are 0-based

    wid = a.window or (sh("xdotool", "search", "--name", "Remote Desktop - RustDesk") or "").split("\n")[0]
    if not wid:
        sys.exit("no RustDesk session window")

    n = display_count() or 2
    if want >= n:
        sys.exit(f"the Mac is only sharing {n} display(s); cannot select {a.display}")

    subprocess.run(["xdotool", "windowactivate", wid]); time.sleep(0.8)
    # Measure against the fullscreen layout: no title bar, toolbar at the top edge.
    subprocess.run(["wmctrl", "-i", "-r", wid, "-b", "add,fullscreen"]); time.sleep(1.2)
    geo = {k: int(v) for k, v in
           (l.split("=") for l in sh("xdotool", "getwindowgeometry", "--shell", wid).split("\n") if "=" in l)}
    cx, top = geo["X"] + geo["WIDTH"] // 2, geo["Y"]
    x0 = max(geo["X"], cx - SEARCH_HALF_W)
    x1 = min(geo["X"] + geo["WIDTH"], cx + SEARCH_HALF_W)

    expanded_here = False
    img = grab()
    ctl = find_control(img, x0, x1, top)
    if ctl is None:
        h = find_handle(img, x0, x1, top)
        if h is None:
            sys.exit("neither the toolbar nor its collapsed handle is on screen")
        click(h[1] - 10, h[2])               # chevron: right-most icon on the handle
        expanded_here = True
        img = grab()
        ctl = find_control(img, x0, x1, top)
        if ctl is None:
            sys.exit("the toolbar did not expand")

    def fold():
        # Leave the toolbar as it was found. Expanded, its handle sits just
        # below the bar, chevron still the right-most icon.
        if expanded_here:
            h = find_handle(grab(), x0, x1, ctl[2] + 30)
            if h is not None:
                click(h[1] - 10, h[2])
        subprocess.run(["wmctrl", "-i", "-r", wid, "-b", "add,fullscreen"])

    result = 1
    for attempt in range(1, a.tries + 1):
        if active_segment(img, ctl, n) == want:
            print(f"on display {a.display}" + (f" (attempt {attempt})" if attempt > 1 else ""))
            result = 0
            break
        left, right, y = ctl
        click((left + right) // 2, y + 10)   # opens the dropdown
        btns = dropdown_buttons(grab(), ctl, n)
        if len(btns) < n:
            print(f"attempt {attempt}: dropdown buttons not found", file=sys.stderr)
            click((left + right) // 2, y + 10)   # close whatever opened
            img = grab()
            continue
        click(*btns[want])
        time.sleep(1.0)
        img = grab()
        ctl = find_control(img, x0, x1, top) or ctl
    else:
        print(f"could not switch to display {a.display}", file=sys.stderr)

    fold()
    xdotool_center = (geo["X"] + geo["WIDTH"] // 2, geo["Y"] + geo["HEIGHT"] // 2)
    subprocess.run(["xdotool", "mousemove", str(xdotool_center[0]), str(xdotool_center[1])])
    return result


sys.exit(main())
